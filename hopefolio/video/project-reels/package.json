    "@remotion/paths": "4.0.529",
    "@remotion/shapes": "^4.0.529",
    "@remotion/transitions": "^4.0.529",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
