{
  "name": "orgx-motion-reel",
  "version": "1.0.0",
  "private": true,
  "description": "OrgX 15s motion reel — MOTION ISN'T PROGRESS. PROOF IS.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
